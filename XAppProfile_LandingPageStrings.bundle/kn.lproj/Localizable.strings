"VERIFICATION_LANDING_CTA_TEXT" = "ಈಗಲೇ ಅರ್ಜಿ ಸಲ್ಲಿಸಿ";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "ಪರಿಶೀಲನೆ";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "ತಿಳಿದುಕೊಳ್ಳಬೇಕಿರುವ ವಿಷಯಗಳು ಮತ್ತು ಅರ್ಜಿ ಸಲ್ಲಿಸುವುದು ಹೇಗೆ ಎಂಬ ವಿವರ ಇಲ್ಲಿದೆ.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "X ನಲ್ಲಿ \"ಪರಿಶೀಲಿಸಿದ\" ಎಂದರೇನು";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "ಸಾರ್ವಜನಿಕ ಆಸಕ್ತಿಯ ಒಂದು ಖಾತೆಯು ಅಸಲಿಯಾಗಿದೆ ಎಂದು ಜನರಿಗೆ ನೀಲಿ ಬ್ಯಾಡ್ಜ್‌ ತಿಳಿಸುತ್ತದೆ. ಸಾರ್ವಜನಿಕ ಸಂವಾದವನ್ನು ನಾವು ಸಂರಕ್ಷಿಸುವ ಒಂದು ವಿಧಾನ ಇದಾಗಿದೆ. ಇದು ಪ್ರೋತ್ಸಾಹದಾಯಕ, ಪ್ರಯೋಜನಕರ ಅಥವಾ ಶಿಫಾರಸುಕರವಲ್ಲ.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "ಯಾರು ಅರ್ಹರು?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "ನೀಲಿ ಬ್ಯಾಡ್ಜ್ ಸ್ವೀಕರಿಸಲು, ನಿಮ್ಮ ಖಾತೆ ಸಕ್ರಿಯವಾಗಿರಬೇಕು, ಅಸಲಿಯಾಗಿರಬೇಕು ಮತ್ತು ಗಮನಾರ್ಹವಾಗಿರಬೇಕು. <a id=\"#\">ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "ಸಕ್ರಿಯ";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "ಸಂಪೂರ್ಣ ಪ್ರೊಫೈಲ್‌ ಮತ್ತು ದೃಢೀಕೃತ ಸಂಪರ್ಕ ವಿಧಾನ ಸೇರಿದಂತೆ ನಮ್ಮ ನಿಯಮಗಳಿಗೆ ಬದ್ಧತೆಯ ದಾಖಲೆಯೊಂದಿಗೆ ನಿಮ್ಮ ಖಾತೆ ಸಕ್ರಿಯವಾಗಿರಬೇಕು.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "ಅಸಲಿ";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "ಪ್ಲಾಟ್‌ಫಾರಂನಲ್ಲಿ ಬಳಕೆದಾರರ ಮಧ್ಯೆ ವಿಶ್ವಾಸವನ್ನು ನಿರ್ವಹಿಸಲು, ಪರಿಶೀಲನೆಗೆ ಒಳಪಡಲು X ಜೊತೆಗೆ ನಿಮ್ಮ ಗುರುತನ್ನೂ ನೀವು ದೃಢೀಕರಿಸಬೇಕು.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "ಗಣ್ಯ";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "ಪ್ರಮುಖವಾಗಿ ಗುರುತಿಸಲ್ಪಟ್ಟ ವ್ಯಕ್ತಿ ಅಥವಾ ಬ್ರ್ಯಾಂಡ್‌ನೊಂದಿಗೆ ನಿಮ್ಮ ಖಾತೆ ಪ್ರತಿನಿಧಿತ್ವ ಹೊಂದಿರಬೇಕು ಅಥವಾ ಸಂಬಂಧ ಹೊಂದಿರಬೇಕು.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "ಪ್ರಕ್ರಿಯೆ ಏನು?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "ಕೇವಲ ಮೂರು ಸರಳ ಹಂತಗಳಲ್ಲಿ ಪರಿಶೀಲನೆಗಾಗಿ ನಿಮ್ಮ ವಿನಂತಿಯನ್ನು ಸಲ್ಲಿಸಿ.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "ನಿಮ್ಮ ಅರ್ಹತೆಯನ್ನು ದೃಢೀಕರಿಸಿ";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "ಅನ್ವಯಿಸಲು, ನಮ್ಮ ನಿಯಮಗಳಿಗೆ ಬದ್ಧವಾಗಿರುವ ದಾಖಲೆಯೊಂದಿಗೆ ನಿಮ್ಮ ಖಾತೆ ಸಕ್ರಿಯವಾಗಿರಬೇಕು ಮತ್ತು ವರ್ಗಕ್ಕೆ ನಿರ್ದಿಷ್ಟವಾದ ಪೂರ್ವ ಅಗತ್ಯಗಳನ್ನು ಪೂರೈಸಬೇಕು.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "ಸಾಕ್ಷಿಗೆ ಲಿಂಕ್‌ಗಳನ್ನು ಸೇರಿಸಿ";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "ನಿಮ್ಮ ಖಾತೆ ಅಸಲಿ ಮತ್ತು ಗಣನೀಯವಾಗಿ ಗುರುತಿಸಿದ ವ್ಯಕ್ತಿ ಅಥವಾ ಬ್ರ್ಯಾಂಡ್ ಅನ್ನು ಪ್ರತಿನಿಧಿಸುತ್ತದೆ ಎಂಬುದಕ್ಕೆ ಸಾಕ್ಷಿಯನ್ನು ನೀಡಲು ನಿಮ್ಮನ್ನು ಕೇಳಲಾಗುತ್ತದೆ.";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್ ಸಲ್ಲಿಸಿ";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "ನಿಮ್ಮ ಅರ್ಜಿಯ ಕುರಿತು ನಿರ್ಧಾರ ಮಾಡುತ್ತಿದ್ದಂತೆಯೇ ನಿಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಲಾಗುತ್ತದೆ. ಈ ಪ್ರಕ್ರಿಯೆಗೆ 14 ದಿನಗಳವರೆಗೆ ತೆಗೆದುಕೊಕೊಳ್ಳಬಹುದು.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "ನೀವು ಪ್ರಯೋಜನ ಪಡೆದುಕೊಳ್ಳಲು ಸಿದ್ಧವಿಲ್ಲದಿದ್ದರೆ, ನಮ್ಮ <a id=\"#\">ಸಹಾಯ ಕೇಂದ್ರದಲ್ಲಿ</a> ಇನ್ನಷ್ಟು ಮಾಹಿತಿಯನ್ನು ಪಡೆಯಿರಿ.";
