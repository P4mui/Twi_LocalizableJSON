"VERIFICATION_LANDING_CTA_TEXT" = "अभी आवेदन करें";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "सत्यापन";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "यहां वह सब कुछ है जो आपको जानना आवश्यक है - और आवेदन करने का तरीका बताया गया है.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "X पर \"सत्यापित\" होने\nका क्या मतलब है";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "ब्लू बैज लोगों को यह बताता है कि जनहित का खाता प्रामाणिक है. यह एक तरीका है जिससे हम सार्वजनिक बातचीत को सुरक्षित रखने में मदद करते हैं. यह कोई प्रोत्साहन, इनाम या अनुमोदन नहीं है.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "कौन पात्र है?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "ब्लू बैज प्राप्त करने के लिए, आपका खाता सक्रिय, प्रामाणिक और उल्लेखनीय होना चाहिए. <a id=\"#\">अधिक जानें</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "सक्रिय";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "आपका खाता पूर्ण प्रोफ़ाइल और पुष्टि हुई संपर्क विधि सहित हमारे नियमों के अनुपालक रिकॉर्ड के साथ सक्रिय होना चाहिए.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "प्रामाणिक";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "प्लेटफ़ॉर्म पर उपयोगकर्ताओं के बीच विश्वास बनाए रखने के लिए, आपको X के साथ अपनी पहचान की पुष्टि करनी होगी, ताकि आपको सत्यापित किया जा सके.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "उल्लेखनीय";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "आपके खाते को किसी जाने पहचाने व्यक्ति या ब्रांड का प्रतिनिधित्व करना चाहिए या अन्यथा उससे संबद्ध होना चाहिए.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "प्रक्रिया क्या है?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "सत्यापन के लिए अपना अनुरोध केवल तीन आसान चरणों में सबमिट करें.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "अपनी पात्रता की पुष्टि करें";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "आपका खाता हमारे नियमों के अनुपालक रिकॉर्ड के साथ सक्रिय होना चाहिए और आवेदन करने के लिए सभी श्रेणी-विशिष्ट पूर्वापेक्षाओं को पूरा करना चाहिए.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "सबूत के लिंक जोड़ें";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "आपको इस बात का सबूत देने के लिए कहा जाएगा कि आपका खाता प्रामाणिक है और किसी जाने पहचाने व्यक्ति या ब्रांड का प्रतिनिधित्व करता है.";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "अपना आवेदन सबमिट करें";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "आपके आवेदन पर निर्णय होते ही आपसे संपर्क किया जाएगा. इस प्रक्रिया में 14 दिन तक लग सकते हैं.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "अगर आप शुरू करने के लिए अभी तैयार नहीं हैं, तो आप हमारे <a id=\"#\">सहायता केंद्र</a> पर अधिक जानकारी देख सकते हैं.";
