"VERIFICATION_LANDING_CTA_TEXT" = "இப்போதே விண்ணப்பிக்கவும்";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "சரிபார்க்கப்பட்டவர்";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "உங்களுக்குத் தெரிய வேண்டிய அனைத்தும், எப்படி விண்ணப்பிப்பது என்பது குறித்த விவரங்களும் இங்குள்ளன.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "X -இல் “சரிபார்க்கப்பட்டது”\nஎன்றால் என்ன";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "பொதுமக்கள் ஆர்வம் கொண்டுள்ள ஒரு கணக்கு நம்பத்தகுந்தது என்பதை நீலநிற முத்திரை மக்களுக்குக் காண்பிக்கிறது. பொது உரையாடல்களைப் பாதுகாக்க நாங்கள் உதவுவதற்கு இது ஒரு வழியாகும். இது ஒரு ஊக்கமோ, பரிசோ, ஒப்புதலோ அல்ல.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "யாரெல்லாம் தகுதியுடையவர்கள்?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "நீலநிற முத்திரையைப் பெற, உங்கள் கணக்கு செயல்பாட்டிலும், நம்பத்தகுந்ததாகவும், குறிப்பிடத்தக்கதாகவும் இருக்க வேண்டும்.<a id=\"#\">மேலும் அறிய</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "செயலிலுள்ளவர்";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "எங்கள் விதிகளுக்கு இணங்க, முழுமையான சுயவிவரம் மற்றும் உறுதிப்படுத்தப்பட்ட தொடர்பு முறை உள்ளிட்ட பதிவுடன் உங்கள் கணக்கு செயலில் இருக்க வேண்டும்.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "நம்பத்தகுந்தவர்";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "தளத்திலுள்ள பயனர்களுக்கிடையே நம்பிக்கையைப் பராமரிக்க, சரிபார்க்கப்படுவதற்கு X -இல் உங்கள் அடையாளத்தையும் நீங்கள் உறுதிப்படுத்த வேண்டும்.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "குறிப்பிடத்தக்கவர்";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "பிரபலமாக அடையாளம் காணப்படக்கூடிய தனிநபர் அல்லது பிராண்டுடன் உங்கள் கணக்கு பிரதிநிதித்துவப்படுத்தப்பட வேண்டும் அல்லது தொடர்புடையதாக இருக்க வேண்டும்.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "செயல்முறை என்ன?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "மூன்று எளிமையான படிநிலைகளில் சரிபார்த்தலுக்கான உங்கள் கோரிக்கையைச் சமர்ப்பியுங்கள்.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "உங்கள் தகுதிநிலையை உறுதிப்படுத்துங்கள்";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "எங்கள் விதிகளுக்கு இணங்க உங்கள் கணக்கு ஒரு பதிவுடன் செயலில் இருக்க வேண்டும், அத்துடன் பொருந்தக்கூடிய வகை ரீதியிலான முன்தேவைகளையும் பூர்த்திசெய்ய வேண்டும்.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "சான்றுக்கு இணைப்புகளைச் சேர்க்கவும்";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "உங்கள் கணக்கு நம்பத்தகுந்தது மற்றும் பிரபலமாக அடையாளம் காணக்கூடிய தனிநபர் அல்லது பிராண்டைப் பிரதிநிதித்துவப்படுத்துகிறது என்பதையும் நிரூபிக்கக்கூடிய சான்றை அளிக்குமாறு கோரப்படுவீர்கள்,";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "உங்கள் விண்ணப்பத்தைச் சமர்ப்பிக்கவும்";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "உங்கள் விண்ணப்பம் பற்றிய முடிவு எடுக்கப்பட்டவுடன் உங்களைத் தொடர்புகொள்வோம். இதற்கு 14 நாட்கள் வரை ஆகலாம்.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "நீங்கள் இன்னும் முழுமையாக மனம் மாறவில்லை என்றால், எங்கள் <a id=\"#\">உதவி மையத்திலிருந்து</a> மேலும் தகவல்களைப் பெறலாம்.";
