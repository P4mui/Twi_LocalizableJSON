"VERIFICATION_LANDING_CTA_TEXT" = "હમણાં જ અરજી કરો";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "ચકાસણી";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "અરજી કરવા માટે તમારે જાણવાની જરૂર હોય તે બધી જ બાબતો — અને તે કેવી રીતે કરવી તે અહીં આપ્યું છે.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "X પર\n\"ચકાસાયેલું\" હોવાનો અર્થ શું થાય છે";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "વાદળી બૅજ લોકોને જણાવે છે કે જાહેર હિતનું એકાઉન્ટ પ્રમાણિત છે. સાર્વજનિક વાર્તાલાપને સુરક્ષિત રાખવામાં અમે કરીએ છીએ તે મદદની આ એક રીત છે. તે ઇન્સેન્ટિવ, રિવોર્ડ અથવા એન્ડૉર્સમેન્ટ નથી.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "કોણ પાત્ર છે?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "વાદળી બૅજ પ્રાપ્ત કરવા માટે, તમારું એકાઉન્ટ સક્રિય, પ્રમાણિત અને નોંધપાત્ર હોવું આવશ્યક છે. <a id=\"#\">વધુ જાણો</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "સક્રિય";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "તમારું એકાઉન્ટ અમારા નિયમોનું પાલન કરવાના રેકોર્ડ સાથે સક્રિય હોવું આવશ્યક છે, જેમાં સંપૂર્ણ પ્રોફાઈલ અને પુષ્ટિ થયેલ સંપર્ક પદ્ધતિનો સમાવેશ થાય છે.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "પ્રમાણિત";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "પ્લેટફોર્મ પર વપરાશકારો વચ્ચે વિશ્વાસ જાળવી રાખવા માટે, તમારે ચકાસાયેલા થવા માટે Xની પાસે તમારી ઓળખની પુષ્ટિ કરવાની પણ જરૂર પડશે.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "નોંધપાત્ર";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "તમારું એકાઉન્ટ મુખ્યત્વે માન્યતા પ્રાપ્ત વ્યક્તિ અથવા બ્રાન્ડનું પ્રતિનિધિત્વ કરતું હોય અથવા અન્યથા તેની સાથે સંકળાયેલું હોય તે આવશ્યક છે.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "પ્રક્રિયા શું છે?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "ફક્ત ત્રણ સરળ પગલાંમાં ચકાસણી માટેની તમારી વિનંતીને સબમિટ કરો.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "તમારી પાત્રતાની પુષ્ટિ કરો";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "તમારું એકાઉન્ટ અમારા નિયમોનું પાલન કરવાના રેકોર્ડ સાથે સક્રિય હોવું અને અરજી કરવા માટે કોઈપણ શ્રેણી-વિશિષ્ટ પૂર્વશરતોને પૂર્ણ કરતું હોવું આવશ્યક છે.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "પુરાવાની લિંક ઉમેરો";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "તમને તમારું એકાઉન્ટ પ્રમાણિત છે અને તે મુખ્યત્વે માન્યતા પ્રાપ્ત વ્યક્તિ અથવા બ્રાન્ડનું પ્રતિનિધિત્વ કરે છે, તેનો પુરાવો પ્રદાન કરવા માટે કહેવામાં આવશે.";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "તમારી અરજી સબમિટ કરો";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "તમારી અરજી અંગે નિર્ણય લેવામાં આવતા જ તમારો સંપર્ક કરવામાં આવશે. આ પ્રક્રિયામાં 14 દિવસ સુધીનો સમય લાગી શકે છે.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "જો તમે આગળ વધવા માટે હજી પૂર્ણપણે તૈયાર નથી, તો તમે અમારા <a id=\"#\">સહાયતા કેન્દ્ર</a>માં વધુ માહિતી મેળવી શકો છો.";
