"VERIFICATION_LANDING_CTA_TEXT" = "Sol·licita-ho ara";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "Verificació";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "Aquí tens tot el que has de saber, a més de les instruccions per fer la sol·licitud.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "Què significa estar\n\"verificat\" a X?";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "La insígnia blava indica que un compte d'interès públic és autèntic. És una manera d'ajudar a protegir la conversa pública. No es tracta d'un incentiu, una recompensa ni una aprovació.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "Qui és apte?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "Per rebre la insígnia blava, el compte ha d'estar actiu i ha de ser autèntic i destacat. <a id=\"#\">Més informació</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "Actiu";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "El compte ha d'estar actiu amb un registre d'adhesió a les normes d'ús, inclòs un perfil complet i un mètode de contacte confirmat.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "Autèntic";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "Per mantenir la confiança entre els usuaris de la plataforma, també hauràs de confirmar la teva identitat a X perquè et puguem verificar.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "Destacat";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "El compte ha de representar una persona individual o una marca reconeguda o hi ha d'estar associat.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "En què consisteix el procés?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "Envia una sol·licitud de verificació en només tres senzills passos.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "Confirma la idoneïtat";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "El compte ha d'estar actiu amb un registre d'adhesió a les normes d'ús i ha de complir els requisits previs específics de la categoria per poder fer la sol·licitud.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "Afegeix enllaços a les proves";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "Se't demanarà que proporcionis proves per demostrar que el compte és autèntic i representa una persona o marca conegudes.";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "Envia la sol·licitud";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "Ens posarem en contacte amb tu tan bon punt s'hagi pres una decisió sobre la sol·licitud. Aquest procés pot tardar fins a 14 dies.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "Si no estàs a punt per fer el salt, en pots obtenir més informació al nostre <a id=\"#\">Centre d'ajuda</a>.";
