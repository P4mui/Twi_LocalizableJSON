"VERIFICATION_LANDING_CTA_TEXT" = "त्वरित अर्ज करा";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "सत्यापन";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "अर्ज कसा करावा — आणि आपणास माहित असणे आवश्यक असलेली प्रत्येक गोष्ट येथे आहे.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "X वर \"सत्यापित\"\nकरून घेणे म्हणजे काय";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "सार्वजनिक हिताचे खाते प्रमाणीकृत आहे हे निळ्या बॅजवरून लोकांना समजते. चर्चा संरक्षित करण्याचा हा एक मार्ग आहे. हा ( बॅज) प्रोत्साहक, पारितोषिक किंवा पृष्ठांकन नाही.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "कोण पात्र आहे?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "निळा बॅज मिळविण्यासाठी, आपले खाते सक्रिय, प्रमाणीकृत आणि लक्षवेधी असणे आवश्यक आहे. <a id=\"#\">अधिक जाणून घ्या</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "सक्रिय करा";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "आपले खाते संपूर्ण प्रोफाइल आणि पुष्टी केलेल्या संपर्क पद्धतीसह आमच्या नियमांचे पालन करण्याच्या रेकॉर्डसहित सक्रिय असणे आवश्यक आहे.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "प्रमाणीकृत";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "प्लॅटफॉर्मवरील उपभोक्त्यांचा विश्वास राखण्यासाठी, सत्यापित होण्यासाठी X वर आपल्याला आपल्या ओळखीची पुष्टी करावी लागेल.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "उल्लेखनीय";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "आपल्या खात्याने प्रामुख्याने ओळखली जाणारी व्यक्ती किंवा ब्रँडचे प्रतिनिधित्व करणे आवश्यक आहे किंवा त्यांच्याशी संबंधित असणे आवश्यक आहे.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "प्रक्रिया काय आहे?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "केवळ तीन सोप्या पायऱ्यांचे अनुसरण करून आपली सत्यापन विनंती सबमिट करा.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "आपल्या पात्रतेची पुष्टी करा";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "आपले खाते आमच्या नियमांचे पालन करण्याच्या रेकॉर्डसहित सक्रिय असणे आवश्यक असून अर्ज करण्यासाठी कोणत्याही श्रेणी-विनिर्दिष्ट पूर्व-आवश्यकता पूर्ण करणे आवश्यक आहे.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "पुराव्यामध्ये लिंक्स समाविष्ट करा";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "आपले खाते प्रमाणीकृत असून स्पष्टपणे ओळखल्या जाणाऱ्या व्यक्ती किंवा ब्रँडचे प्रतिनिधित्व करत असल्याचा पुरावा देण्यासाठी आपणास सूचित केले जाईल.";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "आपला अर्ज सबमिट करा";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "आपल्या अर्जावर निर्णय होताच आपल्याशी संपर्क साधला जाईल. या प्रक्रियेस जास्तीत जास्त 14 दिवस लागू शकतात.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "आपण या प्रक्रियेस तयार नसाल तर आपण आमच्या <a id=\"#\">मदत केंद्र</a> येथे अधिक माहिती मिळवू शकता.";
