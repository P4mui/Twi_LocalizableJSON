"VERIFICATION_LANDING_CTA_TEXT" = "[[242436]] Apply now";
"VERIFICATION_LANDING_SECTION_1_HEADER" = "[[242417]] Verification";
"VERIFICATION_LANDING_SECTION_1_SUBTEXT" = "[[242397]] Here’s everything you need to know — and how to apply.";
"VERIFICATION_LANDING_SECTION_2_HEADER" = "[[278756]] What it means to be\n“Verified” on X";
"VERIFICATION_LANDING_SECTION_2_SUBTEXT" = "[[242429]] The blue badge lets people know that an account of public interest is authentic. It’s one way we help protect the public conversation. It’s not an incentive, reward, or endorsement.";
"VERIFICATION_LANDING_SECTION_3_HEADER_HEADER" = "[[242398]] Who’s eligible?";
"VERIFICATION_LANDING_SECTION_3_HEADER_SUBTEXT" = "[[243450]] To receive the blue badge, your account must be active, authentic, and notable. <a id=\"#\">Learn more</a>";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_HEADER" = "[[242399]] Active";
"VERIFICATION_LANDING_SECTION_3_ITEM_1_SUBTEXT" = "[[278797]] Your account must be active with a record of adherence to our Rules, including a complete profile and a confirmed contact method.";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_HEADER" = "[[242396]] Authentic";
"VERIFICATION_LANDING_SECTION_3_ITEM_2_SUBTEXT" = "[[278780]] To maintain trust between users on the platform, you will also need to confirm your identity with X in order to be Verified.";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_HEADER" = "[[242424]] Notable";
"VERIFICATION_LANDING_SECTION_3_ITEM_3_SUBTEXT" = "[[242411]] Your account must represent or otherwise be associated with a prominently recognized individual or brand.";
"VERIFICATION_LANDING_SECTION_4_HEADER_HEADER" = "[[242408]] What’s the process?";
"VERIFICATION_LANDING_SECTION_4_HEADER_SUBTEXT" = "[[242401]] Submit your request for Verification in just three simple steps.";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_HEADER" = "[[242422]] Confirm your eligibility";
"VERIFICATION_LANDING_SECTION_4_ITEM_1_SUBTEXT" = "[[283458]] Your account must be active with a record of adherence to our Rules and satisfy any category-specific prerequisites to apply.";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_HEADER" = "[[242402]] Add links to evidence";
"VERIFICATION_LANDING_SECTION_4_ITEM_2_SUBTEXT" = "[[242431]] You will be prompted to provide evidence that your account is authentic and represents a prominently recognized individual or brand.";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_HEADER" = "[[242435]] Submit your application";
"VERIFICATION_LANDING_SECTION_4_ITEM_3_SUBTEXT" = "[[243448]] You will be contacted as soon as a decision has been made on your application. This process may take up to 14 days.";
"VERIFICATION_LANDING_SECTION_5_SUBTEXT" = "[[243454]] If you’re not quite ready to take the leap you can get more information at our <a id=\"#\">Help Center</a>.";
